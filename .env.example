# Copy this file to .env.local for local work. .env.local stays out of git.
# On Vercel, set the same names under Settings > Environment Variables. See README.md.

# Supabase project URL, for example https://abcdefghijklmnopqrst.supabase.co
# (Project Settings > Data API). NEXT_PUBLIC_SUPABASE_URL also works.
SUPABASE_URL=

# Supabase secret key, starting with sb_secret_ (Project Settings > API Keys).
# SUPABASE_SERVICE_ROLE_KEY also works. Server only: never give it a NEXT_PUBLIC_ name.
SUPABASE_SECRET_KEY=

# Password for the Excel export at /api/registrations.csv, at least 20 characters. While it is empty or shorter, the export answers "Not found".
# Make a long random one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
REGISTRATIONS_EXPORT_PASSWORD=

# --- Members area: sign-in, courses, chat. See README.md, "Members area". ---

# The same Supabase project URL again, for the browser. With this set, SUPABASE_URL can be left empty.
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key, starting with sb_publishable_ (Project Settings > API Keys). Safe in the browser:
# row level security decides what each member can see.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Razorpay API keys. Use the rzp_test_ pair until the account's KYC is approved.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you choose when adding the webhook https://<your-site>/api/razorpay/webhook in Razorpay.
RAZORPAY_WEBHOOK_SECRET=

# The live site's address, for link previews, for example https://www.example.com
# Leave it commented out locally: an empty value is not a valid address.
# NEXT_PUBLIC_SITE_URL=

# Set to 0 to show the sun as a static SVG instead of WebGL.
# NEXT_PUBLIC_HORIZON_WEBGL=0
